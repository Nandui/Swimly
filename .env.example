# Copy to .env and fill in. .env is gitignored; this file is not.

# Postgres. Anything that speaks it will do — Neon, Supabase, a local server.
DATABASE_URL="postgresql://user:password@localhost:5432/swimly?schema=public"

# Docs content has its own database. Staff authentication still uses DATABASE_URL.
DOCS_DATABASE_URL="postgresql://user:password@localhost:5432/turnfin_docs"
# Unpooled connection to that same Docs database for schema/cutover migrations.
# DOCS_DIRECT_URL="postgresql://user:password@localhost:5432/turnfin_docs"
# HR and performance have their own database too. Unset keeps HR switched off.
# HR_DATABASE_URL="postgresql://user:password@localhost:5432/turnfin_hr"
# HR_DIRECT_URL="postgresql://user:password@localhost:5432/turnfin_hr"

# Only needed where DATABASE_URL is pooled (Neon, Supabase, pgBouncer): the
# unpooled counterpart of the same database, which migrations run over.
# DIRECT_URL="postgresql://user:password@localhost:5432/swimly?schema=public"
# (Vercel's Neon integration names it DATABASE_URL_UNPOOLED; either works.)

# Optional: the most connections each database pool opens. Leave unset; the
# sandbox sets it to 1 because its embedded Postgres is a single session.
# DATABASE_POOL_MAX="1"

# Previews and development: "development" lets builds migrate this database.
# DATABASE_ENVIRONMENT="development"
# Make a preview without that mark fail instead of warn, and refuse a
# development-marked preview that points at production's host.
# REQUIRE_DEV_DATABASE="true"
# PRODUCTION_DATABASE_HOST="ep-example.eu-central-1.aws.neon.tech"

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Set behind a proxy or on a host Auth.js cannot infer.
# AUTH_TRUST_HOST="true"

# Sign in with Google (Production only: previews change address every time).
# Redirect URI: https://<host>/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# Work domains whose Google accounts may get a new account (comma-separated).
# AUTH_GOOGLE_DOMAINS="leisureworldcork.com"

# Development only, and ignored in production builds: signs you in as the
# first active admin in the database, so audit rows name someone real and
# permission checks behave exactly as they will once you sign in properly.
# DEV_AUTH_BYPASS="1"

# Read once, by `npm run db:seed`, to create the first admin. Clear them
# afterwards — the seed declines to run a second time anyway.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""

# Separate parent API. Keep disabled until the additive migration is deployed
# and the parent frontend and verified email sender are ready.
PARENT_API_ENABLED="false"
# A separate random secret of at least 32 characters. Never expose to a frontend.
PARENT_AUTH_SECRET=""
# Exact frontend origins, comma-separated, without a trailing slash. HTTPS in
# production; localhost HTTP is allowed only in development. No wildcards.
PARENT_API_ALLOWED_ORIGINS=""
# Google Workspace mailbox authorization. Request only gmail.send with offline
# access. Keep all three credentials on the staff API, never in the parent app.
# Every setting is described in docs/operations.md.
PARENT_GOOGLE_CLIENT_ID=""
PARENT_GOOGLE_CLIENT_SECRET=""
PARENT_GOOGLE_REFRESH_TOKEN=""
PARENT_EMAIL_FROM="LeisureWorld Aquatics <info@leisureworldcork.com>"
# Turnfin's own sender (Core, src/lib/email/sender.ts) for Turnfin Me, the Academy
# and Refunds. Optional: each falls back to the PARENT_* setting above.
# TURNFIN_GOOGLE_CLIENT_ID=""
# TURNFIN_GOOGLE_CLIENT_SECRET=""
# TURNFIN_GOOGLE_REFRESH_TOKEN=""
# TURNFIN_EMAIL_FROM="no-reply@example.com"
# Training > Courses > Draft from a document. Unset keeps
# AI drafting switched off. Server only; never expose to a frontend.
# ANTHROPIC_API_KEY="sk-ant-..."
# Turnfin's HTTPS address, for links in Refunds and Coinage emails
# (Coinage falls back to REFUNDS_APP_URL).
REFUNDS_APP_URL="https://turnfin.app"
# COINAGE_APP_URL="https://turnfin.app"
# Outside Vercel, enable only when your trusted proxy OVERWRITES x-real-ip.
# Otherwise anonymous requests share a conservative rate-limit bucket.
PARENT_TRUST_PROXY_IP="false"
# Separate server-only signing key, identical in the staff API and parent app.
# Keeps parent rate limits independent when requests pass through the parent app.
PARENT_PROXY_SECRET=""

# Work is done on registered work PCs (Staff → Work devices). When true, only people with
# the "Work from any device" permission (administrators inherit it) can sign in elsewhere.
# Leave false until the centre's PCs are registered.
# WORK_DEVICE_REQUIRED="false"

# Turnfin Me (the staff app, apps/me) talks to /api/staff/v1. Off unless enabled.
# STAFF_API_ENABLED="false"
# STAFF_AUTH_SECRET="at-least-32-random-characters"
# STAFF_API_ALLOWED_ORIGINS="https://me.example.com"
# STAFF_ME_URL="https://me.example.com"   # where reminder emails link
# Sign-in codes and reminders use Turnfin's sender (TURNFIN_*, then PARENT_*).
# Outside production only: print codes to the server console instead of emailing.
# STAFF_EMAIL_DEV_LOG="true"
# Daily reminder digest (Vercel cron sends it as a bearer token).
# CRON_SECRET="at-least-16-random-characters"

# Incidents' CCTV footage: a PRIVATE Vercel Blob store connected to the project sets this.
# Unset, asking for footage is switched off and the report says so.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Outside production only: print footage request emails to the server console instead.
# INCIDENTS_EMAIL_DEV_LOG="true"

# The Academy booking site (apps/academy) talks to /api/academy/v1. Off unless enabled.
# ACADEMY_API_ENABLED="false"
# ACADEMY_AUTH_SECRET="its-own-32-random-characters"
# ACADEMY_API_ALLOWED_ORIGINS="https://academy.example.com"
# ACADEMY_SITE_URL="https://academy.example.com"   # defaults to the first allowed origin
# ACADEMY_EMAIL_NAME="LeisureWorld Academy"
# Outside production only: print booking codes to the server console instead.
# ACADEMY_EMAIL_DEV_LOG="true"

# The secured record-management route (npm run db:check, db:run). Production only.
# SWIMLY_OPERATIONS_TOKEN_SHA256=""
# SWIMLY_OPERATIONS_ACTOR=""
# SWIMLY_OPERATIONS_EXPIRES="2026-12-31T00:00:00Z"

# The sandbox's defaults (npm run sandbox).
# SANDBOX_PORT="3100"
# SANDBOX_DB_PORT="54391"
# SANDBOX_PASSWORD=""

# Turnfin Me and the Academy site each read one setting of their own, in their
# own .env: NEXT_PUBLIC_STAFF_API_URL (apps/me) and NEXT_PUBLIC_ACADEMY_API_URL,
# NEXT_PUBLIC_ACADEMY_NAME (apps/academy). See docs/operations.md.
