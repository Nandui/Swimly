// Swimly — the data layer.
//
// Three rules from the design kit are load-bearing here:
//   * `Role` is the source of truth for permissions. It is mapped onto the
//     three tiers in `src/lib/authz.ts`, and adding a value there without
//     adding it to the map is a type error — which is the point.
//   * `AuditLog` is not optional. Every mutation writes a row, scripts
//     included. See `src/lib/audit.ts`.
//   * Curriculum rows are archived, never deleted, and `onDelete: Restrict`
//     guards the rest — a cascade would silently remove rows the audit log
//     still claims exist.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// **Legacy.** Superseded by the `StaffRole` table, which carries an explicit
/// list of permissions instead of one of three fixed tiers.
///
/// It is still here, and still written on every account, for one reason: the
/// production deployment and the development database are the same Postgres,
/// so a deploy that dropped this column would break the running app between
/// the migration and the next release. `legacyRoleFor()` in
/// `src/lib/staff/permissions.ts` derives it from the permissions a role
/// actually holds, so the column stays truthful without being consulted.
///
/// Drop it — and `User.role` with it — once production is running the release
/// that reads `User.staffRoleId`. Nothing in the app reads it any more.
enum Role {
  ADMIN
  INSTRUCTOR
  VIEWER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum EnrolmentStatus {
  ACTIVE
  WAITLISTED
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

/// Three states, because three is what an instructor can hit accurately on a
/// wet phone. There is no EXCUSED: a reason for an absence goes in the row's
/// `note`, where it reads as prose rather than as a fourth button nobody
/// applies consistently.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

/// The absence of a `CompetencyResult` row means "not assessed". There is no
/// enum value for it, because a row nobody has written is not a judgement.
enum CompetencyStatus {
  WORKING_ON
  ACHIEVED
}

/// A place on an assessment session, and what came of it.
enum AssessmentBookingStatus {
  BOOKED
  ATTENDED
  NO_SHOW
  CANCELLED
}

// ---------------------------------------------------------------------------
// Staff
// ---------------------------------------------------------------------------

/// A named set of permissions. Roles are data rather than an enum, so an admin
/// can make the ones their club actually needs — a Head Coach who may edit the
/// timetable but not accounts, a receptionist who may enrol but not assess.
///
/// `permissions` is a plain string array of keys from
/// `src/lib/staff/permissions.ts` rather than a join table. The catalogue is
/// code — it can only change when a screen or an action changes — so a
/// Permission table would be a second copy of it, kept in step by hand, with
/// nothing to catch it drifting. Unknown keys are ignored on read, which is
/// what makes removing a permission from the catalogue safe.
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  /// Where the role starts after signing in: a key from `ROLE_HOMES` in
  /// `src/lib/staff/permissions.ts` ("calendar", "duty" or "instructor"). A string rather
  /// than an enum for the same reason `permissions` is: the catalogue is code.
  /// The legacy database default is normalized to Today by the app; new roles
  /// explicitly save their chosen home. Existing role rows need no rewrite.
  home        String   @default("overview")
  /// Which screens the role offers at all: keys from `SCREENS` in
  /// `src/lib/staff/screens.ts`. Permissions say what may be changed;
  /// screens say what is on the menu. A role with only "today" is an
  /// instructor whose whole app is the deck.
  screens     String[] @default([])
  /// The three roles the app shipped with. They may be renamed and their
  /// permissions edited, but they cannot be deleted: `seed.ts` and the
  /// migration both name them, and a fresh database has to land somewhere.
  isSystem    Boolean  @default(false)
  sortOrder   Int      @default(0)
  /// A role holding a restricted capability (HR, performance). Only a
  /// superadmin may edit it or assign it; administrators never inherit it.
  restricted  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  assignments RoleAssignment[]

  @@index([sortOrder])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Null for accounts that sign in another way, or have not set one yet.
  passwordHash String?
  /// **Legacy.** Mirrors `staffRole` so the previous release keeps working
  /// against the same database. See the note on the `Role` enum.
  role         Role     @default(VIEWER)
  /// Nullable only so the column could be added to a table that already had
  /// rows. Every account gets one in the same migration, and `auth()` refuses
  /// a session without one.
  staffRoleId  String?
  /// Deactivation is reversible and keeps the audit trail readable; deletion
  /// is not. Prefer this.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- People core (platform access model). All nullable/defaulted: additive. ---
  /// The operator this person works for. Backfilled to LeisureWorld.
  orgId         String?
  /// Line manager: powers the "direct reports" scope. Cycles are refused on write.
  managerId     String?
  jobTitle      String?
  startedOn     DateTime? @db.Date
  primaryClubId String?
  /// Sees everything in the organisation, including restricted (HR) data. A
  /// flag, not a permission, so no role editor can hand it out.
  isSuperadmin  Boolean   @default(false)
  /// Personal PIN for quick switching on shared devices (bcrypt). Never a password.
  pinHash       String?
  /// When the password was last changed or verified for step-up.
  passwordAt    DateTime?
  /// Wrong PINs since the last success; five lock the PIN until a password sign-in.
  pinFailures   Int       @default(0)
  pinLockedAt   DateTime?

  organisation   Organisation?    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  manager        User?            @relation("LineManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        User[]           @relation("LineManager")
  departments    UserDepartment[]
  roleAssignments RoleAssignment[] @relation("AssignedRole")
  qualifications Qualification[]  @relation("QualificationHolder")
  trainingAssignments TrainingAssignment[] @relation("TrainingLearner")
  sharedDevices  SharedDeviceUser[]

  /// `Restrict`, not `SetNull`: an account with no role has no permissions and
  /// cannot sign in, so deleting a role out from under one of its holders
  /// would silently lock them out. The delete is refused and the admin has to
  /// move people off it first.
  staffRole               StaffRole?          @relation(fields: [staffRoleId], references: [id], onDelete: Restrict)
  auditEntries            AuditLog[]
  coursesTaught           Course[]
  classesCovered          ClassCover[]        @relation("ClassCoverBy")
  classesCoveredFor       ClassCover[]        @relation("ClassCoverFor")
  attendanceMarked        AttendanceRecord[]
  assessmentsMade         CompetencyResult[]
  completionsConfirmed    LevelCompletion[]
  classNotes              ClassNote[]
  assessmentSessionsLed   AssessmentSession[] @relation("AssessmentInstructor")
  assessmentBookingsMade  AssessmentBooking[] @relation("AssessmentBookedBy")
  assessmentOutcomesGiven AssessmentBooking[] @relation("AssessmentAssessedBy")

  @@index([role])
  @@index([staffRoleId])
  @@index([managerId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// People core — one organisation chart and person record for every module
// ---------------------------------------------------------------------------

/// The operator. LeisureWorld today; the boundary that lets Turnfin be sold
/// to other operators later without a rewrite. Every new table carries orgId.
model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs              Club[]
  users              User[]
  departments        Department[]
  roleAssignments    RoleAssignment[]
  qualificationTypes QualificationType[]
  qualifications     Qualification[]
  trainingCourses    TrainingCourse[]
  trainingAssignments TrainingAssignment[]
}

/// A team such as Aquatics, Reception or Maintenance. Optionally tied to one
/// site; archived rather than deleted so assignments and history stay readable.
model Department {
  id         String    @id @default(cuid())
  orgId      String
  clubId     String?
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organisation Organisation     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  club         Club?            @relation(fields: [clubId], references: [id], onDelete: SetNull)
  members      UserDepartment[]

  @@unique([orgId, name])
  @@index([orgId, sortOrder])
}

model UserDepartment {
  userId       String
  departmentId String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userId, departmentId])
  @@index([departmentId])
}

/// An additional role for a person, with where it applies. The primary role
/// (`User.staffRoleId`) always applies everywhere; these add access on top.
/// `scopeKind`: "all" | "site" (scopeId = Club) | "department" (scopeId =
/// Department) | "reports" (the holder's own direct and indirect reports).
/// `scopeId` is "" when the kind needs none, so the unique key holds.
model RoleAssignment {
  id          String   @id @default(cuid())
  orgId       String
  userId      String
  roleId      String
  scopeKind   String   @default("all")
  scopeId     String   @default("")
  grantedById String?
  createdAt   DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User         @relation("AssignedRole", fields: [userId], references: [id], onDelete: Cascade)
  role         StaffRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeKind, scopeId])
  @@index([roleId])
}

/// A browser marked as shared (a reception PC, a poolside tablet). Its signed
/// cookie enables PIN quick-switch and short idle sign-out. Revoking it ends
/// quick-switch there at once.
model SharedDevice {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  clubId      String?
  createdById String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  people SharedDeviceUser[]

  @@index([orgId])
}

/// Who can quick-switch on a shared device: people who signed in there with
/// their password at least once and have a PIN.
model SharedDeviceUser {
  deviceId   String
  userId     String
  lastUsedAt DateTime @default(now())

  device SharedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deviceId, userId])
  @@index([userId])
}

/// A kind of certificate: NPLQ, First Aid, Swim Teacher licence. `validityMonths`
/// suggests an expiry date when a qualification is recorded.
model QualificationType {
  id             String    @id @default(cuid())
  orgId          String
  name           String
  validityMonths Int?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation   Organisation    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  qualifications Qualification[]
  trainingCourses TrainingCourse[]

  @@unique([orgId, name])
}

/// A person's certificate. Written by Training (courses, trainer sign-off) or
/// recorded directly; read by Rota (expiry warnings) and the My hub.
model Qualification {
  id           String    @id @default(cuid())
  orgId        String
  userId       String
  typeId       String
  issuedOn     DateTime  @db.Date
  expiresOn    DateTime? @db.Date
  reference    String    @default("")
  note         String    @default("")
  verifiedById String?
  verifiedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organisation Organisation      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User              @relation("QualificationHolder", fields: [userId], references: [id], onDelete: Cascade)
  type         QualificationType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([orgId, expiresOn])
}

model AuditLog {
  id          String   @id @default(cuid())
  /// Nullable so a deleted account does not take its history with it.
  actorId     String?
  /// Denormalised on purpose: the log must still read correctly after the
  /// actor's account is gone.
  actorName   String
  /// "create" | "update" | "delete", or a domain verb.
  action      String
  /// The model name, e.g. "Student".
  entity      String
  entityId    String?
  /// How the log is filtered, because it is how the app is navigated. A plain
  /// column rather than a relation, so the log survives the programme.
  programmeId String?
  /// Which club it happened in, kept the same way and for the same reason: a
  /// plain nullable column. Null for what the clubs share — accounts, roles.
  clubId      String?
  /// Written for a person reading months later: name what changed and to what.
  summary     String
  /// Optional structured evidence for swimmer history. Older summaries remain readable.
  details     Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([programmeId, createdAt])
  @@index([clubId, createdAt])
}

// ---------------------------------------------------------------------------
// Clubs — one app, several sites
// ---------------------------------------------------------------------------

/// A physical site and timetable working area. Classes and assessment sessions
/// belong to a site; swimmers, curriculum, progress, staff and roles are shared.
/// Student and Programme clubId retain registration provenance for old records.
model Club {
  id         String    @id @default(cuid())
  name       String    @unique
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// The operator this site belongs to. Backfilled to LeisureWorld.
  orgId      String?

  organisation       Organisation?       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  programmes         Programme[]
  students           Student[]
  courses            Course[]
  assessmentSessions AssessmentSession[]
  departments        Department[]

  @@index([sortOrder])
}

// ---------------------------------------------------------------------------
// Curriculum — the rules. Admin tier.
// ---------------------------------------------------------------------------

/// `archivedAt` rather than `isActive`, deliberately diverging from `User`:
/// for a curriculum row, *when* it was retired answers "was this required when
/// Ava was assessed?". For an account it answers nothing.
model Programme {
  id           String      @id @default(cuid())
  /// An original site copy linked to the shared definition. Historical IDs remain valid.
  sharedWithId String?
  sharedWith   Programme?  @relation("SharedProgramme", fields: [sharedWithId], references: [id], onDelete: Restrict)
  siteCopies   Programme[] @relation("SharedProgramme")
  clubId       String
  /// Legacy site/name key remains for compatibility. Actions enforce unique
  /// shared programme names; original site copies point at sharedWithId.
  name         String
  description  String?
  /// Resized WebP artwork; bytes are read only by the authenticated image route.
  imageData    Bytes?
  imageVersion String?
  sortOrder    Int         @default(0)
  archivedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  club               Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)
  levels             Level[]
  enrolments         Enrolment[]
  completions        LevelCompletion[]
  assessmentSessions AssessmentSession[]
  assessmentTypes    AssessmentType[]

  @@unique([clubId, name])
  @@index([clubId, sortOrder])
  @@index([sharedWithId])
}

model Level {
  id           String    @id @default(cuid())
  /// An original site copy linked to the shared definition. Historical IDs remain valid.
  sharedWithId String?
  sharedWith   Level?    @relation("SharedLevel", fields: [sharedWithId], references: [id], onDelete: Restrict)
  siteCopies   Level[]   @relation("SharedLevel")
  programmeId  String
  name         String
  description  String?
  imageData    Bytes?
  imageVersion String?
  /// Plain indexed Int, not unique, so reordering is one write per moved row.
  /// The cost: every ordering must tie-break on name. See LIST_ORDER in
  /// `src/lib/curriculum/constants.ts`.
  sortOrder    Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  programme          Programme           @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  competencies       Competency[]
  courses            Course[]
  enrolments         Enrolment[]
  completions        LevelCompletion[]
  assessmentOutcomes AssessmentBooking[]

  @@unique([programmeId, name])
  @@index([programmeId, sortOrder])
  @@index([sharedWithId])
}

model Competency {
  id           String       @id @default(cuid())
  /// An original site copy linked to the shared definition. Historical IDs remain valid.
  sharedWithId String?
  sharedWith   Competency?  @relation("SharedCompetency", fields: [sharedWithId], references: [id], onDelete: Restrict)
  siteCopies   Competency[] @relation("SharedCompetency")
  /// Immutable once results exist — guarded in the action, because moving it
  /// would retroactively rewrite who had completed the level.
  levelId      String
  name         String
  description  String?
  sortOrder    Int          @default(0)
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  level   Level              @relation(fields: [levelId], references: [id], onDelete: Restrict)
  results CompetencyResult[]

  @@unique([levelId, name])
  @@index([levelId, sortOrder])
  @@index([sharedWithId])
}

// ---------------------------------------------------------------------------
// People in the water
// ---------------------------------------------------------------------------

model Student {
  id           String        @id @default(cuid())
  /// Original registration site. Swimmer identity, contacts and progress are shared.
  clubId       String
  /// The club's own identifier, carried over from the system this data came
  /// from. Unique, so a re-import matches rather than duplicating, and so a
  /// mistyped digit collides loudly instead of quietly creating a second
  /// child. Nullable: a swimmer added here first has no number yet.
  memberNumber String?       @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime?     @db.Date
  status       StudentStatus @default(ACTIVE)
  joinedOn     DateTime      @default(now()) @db.Date

  /// Standalone contacts: no family table, so siblings duplicate a parent's
  /// phone number. Named "contact" rather than "guardian" because an adult
  /// swimmer is their own.
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  emergencyName         String?
  emergencyPhone        String?
  emergencyRelationship String?

  /// The most sensitive field in the app. Never rendered in a list; the
  /// register shows only a derived flag, with the text one tap away.
  medicalNotes String?

  photoConsent   Boolean   @default(false)
  photoConsentOn DateTime? @db.Date

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club               Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)
  enrolments         Enrolment[]
  attendance         AttendanceRecord[]
  results            CompetencyResult[]
  completions        LevelCompletion[]
  assessmentBookings AssessmentBooking[]
  cancelledSessions  CancelledClassSwimmer[]
  parentAccess       ParentChildAccess[]
  parentAccessRequests ParentAccessRequest[]
  parentChangeRequests ParentChangeRequest[]
  parentProgress     ParentProgressEvent[]
  enrolmentFollowUps StudentFollowUp[]

  @@index([clubId, status, lastName, firstName])
  @@index([status, lastName, firstName])
}

// ---------------------------------------------------------------------------
// Classes
// ---------------------------------------------------------------------------

model Course {
  id              String    @id @default(cuid())
  /// Always the club of the level's programme; stored here as well so the
  /// timetable is one indexed read rather than a join through the curriculum.
  clubId          String
  levelId         String
  /// Optional. `courseLabel()` falls back to the level name.
  name            String?
  dayOfWeek       DayOfWeek
  /// Minutes from midnight, 0–1439. A weekly recurring time has no date, so a
  /// DateTime here would drag a UTC offset into a value that must read as
  /// "16:30" in every environment.
  startMinutes    Int
  durationMinutes Int
  /// Null means uncapped — squad sessions and adult lane swims do not have
  /// twelve seats.
  capacity        Int?
  /// Nullable so a course can outlive the instructor who taught it.
  instructorId    String?
  location        String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  club            Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  level           Level              @relation(fields: [levelId], references: [id], onDelete: Restrict)
  instructor      User?              @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  enrolments      Enrolment[]
  attendance      AttendanceRecord[]
  notes           ClassNote[]
  covers          ClassCover[]
  assessedResults CompetencyResult[]
  cancellations   ClassCancellation[]

  @@index([clubId, dayOfWeek, startMinutes])
  @@index([levelId])
  @@index([instructorId])
}

enum LegendAgreementStatus {
  NEEDS_CHECK
  PENDING
  DONE
}

/// `levelId` and `programmeId` are **pinned** at enrolment. They are not a
/// cache of the course's level — they are the level the student was *placed*
/// at, which must not move when a course is re-badged.
///
/// There is deliberately no `@@unique([studentId, courseId])`: repeating a
/// level in the same class is the single most common thing a swim school does.
/// The course-row `FOR UPDATE` lock in `withCourseSeat` makes the duplicate
/// check race-free instead.
model Enrolment {
  id              String          @id @default(cuid())
  studentId       String
  courseId        String
  levelId         String
  programmeId     String
  status          EnrolmentStatus @default(ACTIVE)
  startedOn       DateTime        @db.Date
  endedOn         DateTime?       @db.Date
  /// Remains ACTIVE until the app applies this date on its next authenticated request.
  scheduledEndOn  DateTime?       @db.Date
  /// Required when the student is placed at a level they have not earned.
  /// Stored on the row, not only in the audit log, because the log is
  /// admin-only and the instructor on the deck is who needs to know.
  placementReason String?
  /// Existing enrolments remain unverified until staff check Legend. Transfers
  /// copy these fields; they do not restart the billing agreement workflow.
  legendAgreementStatus        LegendAgreementStatus @default(NEEDS_CHECK)
  legendAgreementUpdatedAt     DateTime?
  legendAgreementUpdatedById   String?
  legendAgreementUpdatedByName String?
  /// Explicit teaching handoff for this place, never copied to a new enrolment.
  /// Level and actor IDs are snapshots; their attribution survives later edits.
  readyToMoveAt         DateTime?
  readyToMoveById       String?
  readyToMoveByName     String?
  readyToMoveLevelId    String?
  readyToMoveNote       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  level     Level     @relation(fields: [levelId], references: [id], onDelete: Restrict)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@index([courseId, status])
  @@index([studentId, status])
  @@index([status, scheduledEndOn])
  @@index([programmeId, status])
  @@index([status, legendAgreementStatus, startedOn])
  @@index([status, readyToMoveAt])
}

/// Append-only reception contact/work history shared across sites and programmes.
model StudentFollowUp {
  id             String   @id @default(cuid())
  sequence       Int      @unique @default(autoincrement())
  studentId      String
  operationId    String
  actorId        String
  actorName      String
  clubId         String
  clubName       String
  channel        String
  outcome        String
  note           String
  occurredOn     DateTime @db.Date
  nextContactOn  DateTime? @db.Date
  createdAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([studentId, operationId])
  @@index([studentId, sequence])
}

// ---------------------------------------------------------------------------
// The register
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id           String           @id @default(cuid())
  courseId     String
  studentId    String
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  markedById   String?
  markedByName String
  markedAt     DateTime         @default(now())

  course   Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  markedBy User?   @relation(fields: [markedById], references: [id], onDelete: SetNull)

  /// `studentId` last on purpose: the index then also serves the register's
  /// `(courseId, date)` lookup as a leftmost prefix. One index, two jobs.
  @@unique([courseId, date, studentId])
  @@index([studentId, date])
}

/// Free-text teaching notes. A cancelled occurrence belongs in ClassCancellation,
/// which preserves the schedule and billing roster without inventing absences.
model ClassNote {
  id        String   @id @default(cuid())
  courseId  String
  date      DateTime @db.Date
  note      String
  byId      String?
  byName    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  by     User?  @relation(fields: [byId], references: [id], onDelete: SetNull)

  @@unique([courseId, date])
}

/// A cancelled occurrence of a weekly class. The timetable and enrolments stay
/// intact. Frozen details and roster are the evidence for billing follow-up.
model ClassCancellation {
  id                    String   @id @default(cuid())
  courseId              String
  clubId                String
  date                  DateTime @db.Date
  className             String
  levelName             String
  programmeName         String
  startMinutes          Int
  durationMinutes       Int
  location              String?
  instructorName        String?
  reason                String
  cancelledById         String
  cancelledByName       String
  cancelledAt           DateTime @default(now())
  attendanceRecorded    Int      @default(0)
  billingNotifiedAt      DateTime?
  billingNotifiedById    String?
  billingNotifiedByName  String?
  billingNote           String?

  course   Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  swimmers CancelledClassSwimmer[]

  @@unique([courseId, date])
  @@index([clubId, billingNotifiedAt, date])
}

model CancelledClassSwimmer {
  id             String @id @default(cuid())
  cancellationId String
  studentId      String
  swimmerName    String
  memberNumber   String?

  cancellation ClassCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([cancellationId, studentId])
  @@index([studentId])
}

/// The instructor who confirmed they are teaching this class on this date.
/// Includes the scheduled instructor and substitutes. Created under the course
/// lock before opening the register; an existing claim is never overwritten.
///
/// A teaching claim only. Cancellation lives separately in ClassCancellation.
model ClassCover {
  id             String   @id @default(cuid())
  courseId       String
  date           DateTime @db.Date
  /// Who conducted it. Nullable like every "who", so the record outlives the
  /// account; the name is kept alongside for the same reason.
  coverById      String?
  coverByName    String
  /// Who the class belonged to that day. Null when nobody was assigned.
  instructorId   String?
  instructorName String?
  createdAt      DateTime @default(now())

  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  coverBy    User?  @relation("ClassCoverBy", fields: [coverById], references: [id], onDelete: SetNull)
  instructor User?  @relation("ClassCoverFor", fields: [instructorId], references: [id], onDelete: SetNull)

  @@unique([courseId, date])
  @@index([coverById, date])
}

// ---------------------------------------------------------------------------
// Assessment and progression
// ---------------------------------------------------------------------------

model CompetencyResult {
  id                 String           @id @default(cuid())
  studentId          String
  competencyId       String
  status             CompetencyStatus
  /// Which class it happened in, when it happened in one.
  assessedInCourseId String?
  assessedById       String?
  assessedByName     String
  assessedOn         DateTime         @db.Date
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  student          Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  competency       Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  assessedInCourse Course?    @relation(fields: [assessedInCourseId], references: [id], onDelete: SetNull)
  assessedBy       User?      @relation(fields: [assessedById], references: [id], onDelete: SetNull)

  @@unique([studentId, competencyId])
  @@index([competencyId, status])
}

/// The truth for "done". Eligibility is only ever computed for students who
/// have *not* completed a level — otherwise adding a competency to the
/// curriculum would retroactively un-complete an entire cohort.
model LevelCompletion {
  id          String   @id @default(cuid())
  studentId   String
  levelId     String
  programmeId String
  completedOn DateTime @db.Date

  /// Frozen at confirmation. Without the snapshot, one curriculum edit later
  /// nobody can tell whether a completion was earned or waved through.
  competenciesAchieved Int
  competencyCount      Int

  /// Non-null means "confirmed with gaps" — admin tier only.
  overrideReason  String?
  confirmedById   String?
  confirmedByName String
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  level       Level     @relation(fields: [levelId], references: [id], onDelete: Restrict)
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  confirmedBy User?     @relation(fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([studentId, levelId])
  @@index([programmeId, completedOn])
}

/// A one-off assessment session: a date, a time, a pool and a number of
/// places, at which children who are not yet placed are watched in the water
/// and told which level they belong at.
///
/// Deliberately **not** a `Course`. A course is weekly and has no date; an
/// assessment happens once. Modelling it as a course would put a repeating
/// class in the timetable forever, and bolting dates onto `Course` would
/// rebuild class sessions by accident — the seam DESIGN.md defers. This is
/// the one place the app holds a dated event, and it is scoped to exactly
/// this purpose.
model AssessmentSession {
  id              String    @id @default(cuid())
  /// The programme's club, stored here too so the list is one indexed read.
  clubId          String
  date            DateTime  @db.Date
  /// Minutes from midnight, as on `Course`, and for the same reason.
  startMinutes    Int
  durationMinutes Int       @default(30)
  location        String?
  /// Null means uncapped.
  capacity        Int?
  instructorId    String?
  /// The programme this session places children into. An outcome is one of
  /// its levels, and nothing else.
  programmeId     String
  /// What kind of assessment: the programme's own list — new swimmers, mixed
  /// abilities. Nullable only for sessions made before kinds existed; every
  /// new session is given one, and the page says so where it is missing.
  typeId          String?
  notes           String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  club       Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)
  programme  Programme           @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  type       AssessmentType?     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  instructor User?               @relation("AssessmentInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  bookings   AssessmentBooking[]
  parentPublication ParentAssessmentPublication?

  @@index([clubId, date, startMinutes])
  @@index([programmeId, date])
  @@index([typeId])
}

/// A kind of assessment a programme runs — "New swimmers", "Mixed abilities".
/// Managed on the programme, like its levels, so the desk picks from a list
/// rather than typing a category that fragments into three spellings.
/// Archived, never deleted: a session keeps saying what kind it was.
model AssessmentType {
  id           String           @id @default(cuid())
  /// An original site copy linked to the shared definition. Historical IDs remain valid.
  sharedWithId String?
  sharedWith   AssessmentType?  @relation("SharedAssessmentType", fields: [sharedWithId], references: [id], onDelete: Restrict)
  siteCopies   AssessmentType[] @relation("SharedAssessmentType")
  programmeId  String
  name         String
  description  String?
  sortOrder    Int              @default(0)
  archivedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  programme Programme           @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  sessions  AssessmentSession[]

  @@unique([programmeId, name])
  @@index([programmeId, sortOrder])
  @@index([sharedWithId])
}

/// A child booked onto a session, and — once they have been in the water —
/// the level the assessor placed them at.
///
/// The outcome is what grants eligibility: a swimmer assessed as Turtles has
/// earned a place at Turtles, and at anything below it in that programme,
/// without a completion having to be invented for levels they were never in.
/// `hasEarnedPlace` reads these.
model AssessmentBooking {
  id             String                  @id @default(cuid())
  sessionId      String
  studentId      String
  status         AssessmentBookingStatus @default(BOOKED)
  bookedById     String?
  /// Denormalised, as every "who did this" is, so the record outlives the account.
  bookedByName   String
  /// Null until the assessor has decided.
  outcomeLevelId String?
  outcomeNote    String?
  assessedById   String?
  assessedByName String?
  assessedOn     DateTime?               @db.Date
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  session      AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  outcomeLevel Level?            @relation(fields: [outcomeLevelId], references: [id], onDelete: Restrict)
  bookedBy     User?             @relation("AssessmentBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)
  assessedBy   User?             @relation("AssessmentAssessedBy", fields: [assessedById], references: [id], onDelete: SetNull)
  parentRequests ParentBookingRequest[]

  /// One booking per child per session. Re-booking after a cancellation is
  /// an update of that row, not a second one.
  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@index([outcomeLevelId])
}

// Parent identities never receive a staff User or staff permissions.
model ParentAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions ParentSession[]
  requests ParentBookingRequest[]
  accessRequests ParentAccessRequest[]
  changeRequests ParentChangeRequest[]
}

/// Parent-supplied details are a request, never proof of access to a swimmer.
model ParentAccessRequest {
  id String @id @default(cuid())
  parentId String
  key String
  requestHash String
  childFingerprint String
  firstName String
  lastName String
  dateOfBirth DateTime @db.Date
  context String
  status String @default("PENDING")
  studentId String?
  reviewedById String?
  reviewedByName String?
  reviewedAt DateTime?
  reply String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)
  @@unique([parentId, key])
  student Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@index([parentId, createdAt])
  @@index([status, createdAt])
}

model ParentSession {
  id        String   @id @default(cuid())
  parentId  String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)
  @@index([parentId, expiresAt])
}

model ParentSignInChallenge {
  id        String   @id
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}

/// Infrastructure counters; keys are hashed and never contain an email or IP.
model ParentRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

/// Staff can approve an email before signup; verified email ownership is required.
model ParentChildAccess {
  id          String   @id @default(cuid())
  parentEmail String
  studentId   String
  source      String
  grantedById String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([parentEmail, studentId])
  @@index([studentId])
}

model ParentAssessmentPublication {
  sessionId       String   @id
  enabled         Boolean  @default(false)
  bookingClosesAt DateTime?
  updatedAt       DateTime @updatedAt
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
}

/// Durable request IDs protect child creation as well as seat allocation on retries.
model ParentBookingRequest {
  id          String   @id @default(cuid())
  parentId    String
  key         String
  requestHash String
  bookingId   String
  createdAt   DateTime @default(now())
  parent ParentAccount @relation(fields: [parentId], references: [id], onDelete: Restrict)
  booking AssessmentBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@unique([parentId, key])
  @@index([bookingId])
}

/// Database triggers preserve released values when staff edit or clear progress.
/// Payloads contain only parent-safe values; notes and staff audit text stay separate.
model ParentProgressEvent {
  id         BigInt   @id @default(autoincrement())
  studentId  String
  kind       String
  subjectId  String
  value      Json?
  recordedAt DateTime @default(now())
  releaseAt  DateTime
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@index([studentId, kind, subjectId, releaseAt, id])
}

// Refunds is a separate staff module. Identity/site IDs and names are snapshots;
// retiring accounts or facilities must not erase a financial handoff's history.
model RefundRequest {
  id String @id
  number Int @unique @default(autoincrement())
  status String @default("DRAFT")
  version Int @default(1)
  creatorId String
  creatorName String
  clubId String
  clubName String
  customerName String @default("")
  contactEmail String @default("")
  contactPhone String @default("")
  memberNumber String @default("")
  service String @default("OTHER")
  description String @default("")
  requestedCents Int?
  paymentDate String @default("")
  paymentReference String @default("")
  reason String @default("")
  handlerId String?
  handlerName String?
  approvedCents Int?
  approvedById String?
  approvedByName String?
  paidOn String?
  paidMethod String?
  paidReference String?
  paidById String?
  paidByName String?
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events RefundEvent[]
  attachments RefundAttachment[]
  notifications RefundNotification[]
  @@index([status, submittedAt])
  @@index([clubId, status])
  @@index([creatorId])
  @@index([handlerId])
  @@index([paymentReference])
}

model RefundEvent {
  id String @id @default(cuid())
  requestId String
  operationId String
  actorId String
  actorName String
  action String
  note String @default("")
  snapshot Json
  createdAt DateTime @default(now())
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  notifications RefundNotification[]
  @@unique([requestId, operationId])
  @@index([requestId, createdAt])
}

model RefundAttachment {
  id String @id
  requestId String
  name String
  mime String
  size Int
  bytes Bytes
  createdById String
  createdAt DateTime @default(now())
  removedAt DateTime?
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@index([requestId])
}

model RefundNotification {
  id String @id @default(cuid())
  requestId String
  eventId String
  recipientId String
  status String @default("PENDING")
  attempts Int @default(0)
  attemptedAt DateTime?
  error String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  event RefundEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@unique([eventId, recipientId])
  @@index([requestId, status])
}

/// A parent's proposed correction to their child's contact, emergency or
/// medical details. Nothing on the swimmer changes until reception reviews it
/// and applies it (audited); a declined request keeps the reply for the parent.
/// `proposed` holds only the fields a parent may propose (see
/// src/lib/parent/change-requests.ts). Parents never receive the current values.
model ParentChangeRequest {
  id             String    @id @default(cuid())
  parentId       String
  studentId      String
  key            String
  requestHash    String
  status         String    @default("PENDING")
  proposed       Json
  message        String    @default("")
  reply          String    @default("")
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent  ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([parentId, key])
  @@index([status, createdAt])
  @@index([studentId])
}

/// Training (phase 6): a course in the organisation's catalogue. Learners read
/// the material and mark it done; a practical course also needs a trainer's
/// sign-off. Completing a course that grants a qualification records it, with
/// the expiry from the qualification type's validity.
model TrainingCourse {
  id              String    @id @default(cuid())
  orgId           String
  title           String
  summary         String    @default("")
  /// Plain-text material: what to read, watch or practise.
  content         String    @default("")
  requiresSignoff Boolean   @default(false)
  grantsTypeId    String?
  archivedAt      DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  grantsType   QualificationType?   @relation(fields: [grantsTypeId], references: [id], onDelete: SetNull)
  assignments  TrainingAssignment[]

  @@unique([orgId, title])
}

/// One person's training on one course. ASSIGNED → (SUBMITTED, awaiting a
/// trainer's sign-off) → COMPLETED, or CANCELLED. One open assignment per
/// person and course (partial unique index in the migration).
model TrainingAssignment {
  id              String    @id @default(cuid())
  orgId           String
  courseId        String
  userId          String
  status          String    @default("ASSIGNED")
  dueOn           DateTime? @db.Date
  assignedById    String?
  assignedByName  String
  assignedAt      DateTime  @default(now())
  learnerNote     String    @default("")
  submittedAt     DateTime?
  completedAt     DateTime?
  signedOffById   String?
  signedOffByName String?
  signoffNote     String    @default("")
  qualificationId String?
  cancelledAt     DateTime?
  cancelReason    String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user         User           @relation("TrainingLearner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orgId, status])
  @@index([courseId])
}
