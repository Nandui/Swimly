// Rota (main database).

/// Rota (phase 8): one shift at a site on a day. `userId` null is an open
/// shift. A required qualification only warns when the person does not hold
/// it on that day; the rota never blocks (owner decision, September 2026).
model RotaShift {
  id             String    @id @default(cuid())
  orgId          String
  siteId         String
  date           DateTime  @db.Date
  startMinutes   Int
  endMinutes     Int
  role           String
  requiredTypeId String?
  userId         String?
  note           String    @default("")
  createdById    String?
  createdByName  String
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Who is rostered, from the imported roster: set for everyone on it,
  /// login or not. `userId` is also set when that person has an account.
  rotaPersonId   String?
  /// "shift" (times), "holiday" (FHOP, full holiday paid) or "leave" (another
  /// roster code, kept in `note`). Only shifts count as work.
  kind           String    @default("shift")
  /// The roster's department code, e.g. "520"; its site and label are in RotaDepartment.
  departmentCode String?
  /// The roster upload that created it; null for a shift added by hand.
  importId       String?
  /// The department the duty belongs to (Core's Department), for the week
  /// plan's grouping. Null on old and imported shifts.
  departmentId   String?
  /// A place on one session of a booking (school lessons, a party, lane hire):
  /// the booking, and which of its needs this place fills.
  bookingId      String?
  bookingNeedId  String?

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  site         Club               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  requiredType QualificationType? @relation(fields: [requiredTypeId], references: [id], onDelete: SetNull)
  user         User?              @relation("RotaShiftAssignee", fields: [userId], references: [id], onDelete: SetNull)
  rotaPerson   RotaPerson?        @relation(fields: [rotaPersonId], references: [id], onDelete: SetNull)
  import       RotaImport?        @relation(fields: [importId], references: [id], onDelete: SetNull)
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  booking      RotaBooking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingNeed  RotaBookingNeed?   @relation(fields: [bookingNeedId], references: [id], onDelete: SetNull)
  changes      RotaShiftChange[]
  segments     RotaShiftSegment[]

  @@index([siteId, date])
  @@index([userId, date])
  @@index([rotaPersonId, date])
  @@index([importId])
  @@index([departmentId])
  @@index([bookingId])
}

/// Something at a site that needs staff (owner request, 1 October 2026):
/// school lessons, a party, lane hire, an event. It runs on the chosen weekdays
/// from `firstDay` to `lastDay` (one day for a one-off), and each session gets a
/// duty per place it needs, unfilled until a supervisor plans who. Cancelling
/// it cancels its sessions still to come.
model RotaBooking {
  id            String     @id @default(cuid())
  orgId         String
  siteId        String
  departmentId  String?
  /// school | party | lanes | event | other (`BOOKING_KIND_META`)
  kind          String
  /// Who it is for, e.g. "Example National School".
  title         String
  /// Where at the site, e.g. "Learner pool".
  place         String     @default("")
  /// Monday = 0 to Sunday = 6.
  weekdays      Int[]
  startMinutes  Int
  endMinutes    Int
  firstDay      DateTime   @db.Date
  lastDay       DateTime   @db.Date
  /// Dates between the first and last day it does not run (a bank holiday, a mid-term break).
  skipDates     DateTime[] @default([]) @db.Date
  note          String     @default("")
  createdById   String?
  createdByName String
  cancelledAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  site       Club              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  needs      RotaBookingNeed[]
  shifts     RotaShift[]

  @@index([siteId, lastDay])
}

/// The staff a booking needs at each session: a role, how many, and the
/// qualification it needs (e.g. 2 swim teachers, 1 lifeguard with NPLQ).
model RotaBookingNeed {
  id             String  @id @default(cuid())
  bookingId      String
  role           String
  count          Int
  requiredTypeId String?

  booking      RotaBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requiredType QualificationType? @relation(fields: [requiredTypeId], references: [id], onDelete: SetNull)
  shifts       RotaShift[]

  @@index([bookingId])
}

/// A change to a duty once its week has started (owner request, 1 October
/// 2026): Timepoint already holds that week, so each change keeps its reason
/// (`ROTA_CHANGE_REASON_META`), the absence it covers when it does, and
/// whether Timepoint was updated. It goes on the personal file of each
/// person it moves, and an open "Update Timepoint" is a follow-up.
model RotaShiftChange {
  id              String    @id @default(cuid())
  orgId           String
  shiftId         String
  siteId          String
  /// The duty's day.
  date            DateTime  @db.Date
  /// added | changed | cancelled
  kind            String
  /// What it was and what it is now, in words ("Lifeguard 14:00–22:00, Ava Example").
  before          String    @default("")
  after           String    @default("")
  /// The people it took off and put on the duty, for their personal file.
  fromUserId      String?
  toUserId        String?
  /// cover | swap | extra | correction
  reason          String
  /// The absence it covers, when the reason is cover.
  absenceId       String?
  note            String    @default("")
  byId            String?
  byName          String
  timepointAt     DateTime?
  timepointById   String?
  timepointByName String?
  createdAt       DateTime  @default(now())

  shift RotaShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([orgId, date])
  @@index([shiftId])
  @@index([fromUserId])
  @@index([toUserId])
}

/// Someone on the imported roster (the payroll export's EmpNo and name),
/// login or not. Linked to their Turnfin account when one clearly matches, so
/// they see their shifts in Turnfin Me.
model RotaPerson {
  id         String   @id @default(cuid())
  orgId      String
  employeeNo String
  name       String
  userId     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User?         @relation("RotaPersonAccount", fields: [userId], references: [id], onDelete: SetNull)
  shifts       RotaShift[]
  absences     RotaAbsence[]

  @@unique([orgId, employeeNo])
}

/// A roster department code (e.g. "520") and where it works: its site and a
/// label for the rota. A code without a site stops an import until a manager
/// says where it belongs.
model RotaDepartment {
  id        String   @id @default(cuid())
  orgId     String
  code      String
  label     String   @default("")
  siteId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  site         Club?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([orgId, code])
}

/// One upload of a week's roster. A later upload of the same week replaces
/// its shifts; what moved is recorded as RotaChange rows.
model RotaImport {
  id             String   @id @default(cuid())
  orgId          String
  weekStart      DateTime @db.Date
  fileName       String
  importedById   String?
  importedByName String
  shifts         Int      @default(0)
  holidays       Int      @default(0)
  people         Int      @default(0)
  added          Int      @default(0)
  removed        Int      @default(0)
  changed        Int      @default(0)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  rotaShifts   RotaShift[]
  changes      RotaChange[]

  @@index([orgId, weekStart])
}

/// What one re-upload changed for one person on one day: "added", "removed"
/// or "changed", with the day's entries before and after as plain text.
model RotaChange {
  id         String   @id @default(cuid())
  orgId      String
  importId   String
  date       DateTime @db.Date
  employeeNo String
  personName String
  kind       String
  before     String   @default("")
  after      String   @default("")
  createdAt  DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  import       RotaImport   @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([orgId, date])
}

/// Someone off work (Rota, docs/rota.md): sickness, a family emergency, a
/// bereavement or another reason, from `firstDay` to `lastDay` (null while
/// they are still off). Their shifts in that time warn "Absent" on the rota;
/// the reason is shown only to rota managers. `withdrawnAt` marks one
/// recorded in error.
model RotaAbsence {
  id                String    @id @default(cuid())
  orgId             String
  /// The person's account, when they have one; `rotaPersonId` covers everyone
  /// on the imported roster, login or not. At least one is set.
  userId            String?
  rotaPersonId      String?
  reason            String
  firstDay          DateTime  @db.Date
  lastDay           DateTime? @db.Date
  note              String    @default("")
  reportedById      String?
  reportedByName    String
  /// Off again soon after an earlier absence, and the manager said it is the
  /// same thing: that earlier absence. A plain extension changes `lastDay`
  /// instead and is kept in `updates`.
  continuesId       String?
  /// The return-to-work conversation, held once they are back (from their
  /// first shift): when, whether they are fit to work or need changes to it,
  /// whether a fit note came in (sickness over 7 days) and a note. Null until
  /// it is recorded. It goes on their personal file (the HR record).
  returnMetOn       DateTime? @db.Date
  /// fit | adjusted (`RETURN_FIT_META`)
  returnFit         String?
  returnAdjustments String    @default("")
  returnFitNote     Boolean?
  returnNote        String    @default("")
  returnById        String?
  returnByName      String?
  withdrawnAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organisation Organisation        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User?               @relation("RotaAbsentPerson", fields: [userId], references: [id], onDelete: Cascade)
  rotaPerson   RotaPerson?         @relation(fields: [rotaPersonId], references: [id], onDelete: Cascade)
  continues    RotaAbsence?        @relation("RotaAbsenceAgain", fields: [continuesId], references: [id], onDelete: SetNull)
  followedBy   RotaAbsence[]       @relation("RotaAbsenceAgain")
  updates      RotaAbsenceUpdate[]

  @@index([orgId, firstDay])
  @@index([userId, firstDay])
  @@index([rotaPersonId, firstDay])
  @@index([continuesId])
}

/// The story of one absence: reported, extended (with the new last day, or
/// none when the return is not known), back. Kept so a manager sees how a
/// "two days" became two weeks.
model RotaAbsenceUpdate {
  id        String    @id @default(cuid())
  absenceId String
  /// reported | extended | back
  kind      String
  lastDay   DateTime? @db.Date
  note      String    @default("")
  byId      String?
  byName    String
  createdAt DateTime  @default(now())

  absence RotaAbsence @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  @@index([absenceId, createdAt])
}

/// What someone does during a stretch of their shift (owner request, October
/// 2026: "assigning their activity during a shift and all the breaks"): an
/// activity such as "25m pool lifeguard" or "Reception", or a break. Inside the
/// shift's times, never overlapping each other. Time with no segment is just
/// the shift's own duty.
model RotaShiftSegment {
  id           String   @id @default(cuid())
  shiftId      String
  startMinutes Int
  endMinutes   Int
  /// "activity" or "break" (`SEGMENT_KIND_META`).
  kind         String
  /// The activity, e.g. "25m pool lifeguard"; "Break" for a break.
  label        String
  createdAt    DateTime @default(now())

  shift RotaShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

/// The day's note on the plan, e.g. a last day, or who covers whom and why.
/// One per site per day; empty text removes it.
model RotaDayNote {
  id        String   @id @default(cuid())
  orgId     String
  siteId    String
  date      DateTime @db.Date
  text      String
  byId      String?
  byName    String
  updatedAt DateTime @updatedAt

  site Club @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
}

/// Something the site needs covered during a day, on the plan in its own
/// right (owner request, October 2026: "the activity to be on the planner and
/// on click allow assigning staff that is available with the correct needs"):
/// "25m pool lifeguard" from 06:30 to 21:30, one person at a time, holding a
/// pool lifeguard qualification. People cover it through activities inside
/// their shifts (`RotaShiftSegment` with the same name); the plan shows when
/// fewer than `people` are on it.
model RotaActivity {
  id             String   @id @default(cuid())
  orgId          String
  siteId         String
  date           DateTime @db.Date
  label          String
  startMinutes   Int
  endMinutes     Int
  /// How many people at once, e.g. 2 on poolside.
  people         Int      @default(1)
  requiredTypeId String?
  /// The department that plans it; none for one the whole site shares.
  departmentId   String?
  note           String   @default("")
  createdById    String?
  createdByName  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site         Club               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  requiredType QualificationType? @relation(fields: [requiredTypeId], references: [id], onDelete: SetNull)
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([siteId, date])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Rota, rebuilt (owner decisions, 6 October 2026; docs/rota.md). The rota is
// built from activities: each day's needs ("Lifeguarding, Main pool, 07:00 to
// 21:30, 3 places") and the people put on each place. Shifts, breaks and gaps
// are worked out from these, never stored. The rota tables above are retired,
// kept unread until development has its own database (changes are additive).
// ---------------------------------------------------------------------------

/// One activity at a site on a day, needing `places` people at once from
/// start to end. Each place is a lane on the plan.
model RotaNeed {
  id            String   @id @default(cuid())
  orgId         String
  siteId        String
  date          DateTime @db.Date
  typeId        String
  /// Where in the site: "Main pool". Free text, offered back from earlier days.
  place         String   @default("")
  startMinutes  Int
  endMinutes    Int
  places        Int      @default(1)
  note          String   @default("")
  /// The repeating booking that made it, if any; it is then edited one day at a time.
  repeatId      String?
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site        Club             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  type        ActivityType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  repeat      RotaRepeat?      @relation(fields: [repeatId], references: [id], onDelete: SetNull)
  assignments RotaAssignment[]

  @@index([siteId, date])
  @@index([repeatId])
}

/// A person on one place of a need, for all or part of its time.
model RotaAssignment {
  id            String   @id @default(cuid())
  needId        String
  /// 1 to the need's `places`.
  place         Int
  userId        String
  startMinutes  Int
  endMinutes    Int
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  need RotaNeed @relation(fields: [needId], references: [id], onDelete: Cascade)
  user User     @relation("RotaAssignee", fields: [userId], references: [id], onDelete: Restrict)

  @@index([needId])
  @@index([userId])
}

/// Someone put on a shift on the plan before their activities (owner decision, 8 October
/// 2026): "add a staff member to a shift, then assign activities to them". Their activities
/// fill it; anyone on an activity without one still gets a shift worked out from what they are on.
model RotaPlanShift {
  id            String   @id @default(cuid())
  orgId         String
  siteId        String
  /// The department whose plan it is on.
  departmentId  String
  date          DateTime @db.Date
  userId        String
  startMinutes  Int
  endMinutes    Int
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site       Club       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user       User       @relation("RotaPlanShifts", fields: [userId], references: [id], onDelete: Restrict)

  @@index([siteId, date])
  @@index([userId, date])
}

/// A break placed by the manager (handbook: "all breaks will be allocated by the Manager on
/// shift"). A person's day at a site keeps the breaks placed for it; any the handbook owes them
/// that are not placed are suggested where they have nothing on.
model RotaBreak {
  id           String   @id @default(cuid())
  orgId        String
  siteId       String
  date         DateTime @db.Date
  userId       String
  startMinutes Int
  minutes      Int
  paid         Boolean
  byId         String?
  byName       String
  createdAt    DateTime @default(now())

  site Club @relation(fields: [siteId], references: [id], onDelete: Restrict)
  user User @relation("RotaBreaks", fields: [userId], references: [id], onDelete: Restrict)

  @@index([siteId, date])
  @@index([userId, date])
}

/// A department's week at a site, shared with its staff: from then on they see
/// it in Turnfin Me and hear about changes to their own activities.
model RotaWeekShare {
  id           String   @id @default(cuid())
  siteId       String
  departmentId String
  /// The week's Monday.
  monday       DateTime @db.Date
  sharedAt     DateTime @default(now())
  sharedById   String?
  sharedByName String

  site       Club       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([siteId, departmentId, monday])
}

/// A change to a day that had already come (today or earlier), with its
/// reason, and whether Timepoint has been updated to match.
model RotaLog {
  id              String    @id @default(cuid())
  orgId           String
  siteId          String
  date            DateTime  @db.Date
  /// "added", "removed" or "changed".
  kind            String
  /// "Ciara Murphy put on Lifeguarding, Main pool, 07:00 to 12:00".
  summary         String
  /// The person it moved, for their personal file.
  userId          String?
  /// A key of ROTA_CHANGE_REASON_META.
  reason          String
  note            String    @default("")
  /// The absence it covers, when the reason is cover.
  absenceId       String?
  byId            String?
  byName          String
  createdAt       DateTime  @default(now())
  timepointAt     DateTime?
  timepointById   String?
  timepointByName String?

  site Club @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId, date])
  @@index([userId])
}

/// A booking that repeats (school lessons, lane hire): it makes the same need
/// on each of its days. Cancelling removes the days still to come.
model RotaRepeat {
  id            String     @id @default(cuid())
  orgId         String
  siteId        String
  /// A key of BOOKING_KIND_META.
  kind          String
  title         String
  typeId        String
  place         String     @default("")
  startMinutes  Int
  endMinutes    Int
  places        Int        @default(1)
  /// Monday = 0.
  weekdays      Int[]
  firstDay      DateTime   @db.Date
  lastDay       DateTime   @db.Date
  skipDates     DateTime[] @db.Date
  createdById   String?
  createdByName String
  createdAt     DateTime   @default(now())
  cancelledAt   DateTime?

  site  Club         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  type  ActivityType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  needs RotaNeed[]

  @@index([siteId])
}
