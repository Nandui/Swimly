// Work modules that live in the main database: Refunds, Training and Rota.
// (Docs and HR keep their own databases.)

// Refunds is a separate staff module. Identity/site IDs and names are snapshots;
// retiring accounts or facilities must not erase a financial handoff's history.
model RefundRequest {
  id String @id
  number Int @unique @default(autoincrement())
  status String @default("DRAFT")
  version Int @default(1)
  creatorId String
  creatorName String
  clubId String
  clubName String
  customerName String @default("")
  contactEmail String @default("")
  contactPhone String @default("")
  memberNumber String @default("")
  service String @default("OTHER")
  description String @default("")
  requestedCents Int?
  paymentDate String @default("")
  paymentReference String @default("")
  reason String @default("")
  handlerId String?
  handlerName String?
  approvedCents Int?
  approvedById String?
  approvedByName String?
  paidOn String?
  paidMethod String?
  paidReference String?
  paidById String?
  paidByName String?
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events RefundEvent[]
  attachments RefundAttachment[]
  notifications RefundNotification[]
  @@index([status, submittedAt])
  @@index([clubId, status])
  @@index([creatorId])
  @@index([handlerId])
  @@index([paymentReference])
}

model RefundEvent {
  id String @id @default(cuid())
  requestId String
  operationId String
  actorId String
  actorName String
  action String
  note String @default("")
  snapshot Json
  createdAt DateTime @default(now())
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  notifications RefundNotification[]
  @@unique([requestId, operationId])
  @@index([requestId, createdAt])
}

model RefundAttachment {
  id String @id
  requestId String
  name String
  mime String
  size Int
  bytes Bytes
  createdById String
  createdAt DateTime @default(now())
  removedAt DateTime?
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@index([requestId])
}

model RefundNotification {
  id String @id @default(cuid())
  requestId String
  eventId String
  recipientId String
  status String @default("PENDING")
  attempts Int @default(0)
  attemptedAt DateTime?
  error String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  event RefundEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@unique([eventId, recipientId])
  @@index([requestId, status])
}

/// Training (phase 6): a course in the organisation's catalogue. Learners read
/// the material and mark it done; a practical course also needs a trainer's
/// sign-off. Completing a course that grants a qualification records it, with
/// the expiry from the qualification type's validity.
model TrainingCourse {
  id              String    @id @default(cuid())
  orgId           String
  title           String
  summary         String    @default("")
  /// Plain-text material: what to read, watch or practise.
  content         String    @default("")
  requiresSignoff Boolean   @default(false)
  grantsTypeId    String?
  archivedAt      DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  grantsType   QualificationType?   @relation(fields: [grantsTypeId], references: [id], onDelete: SetNull)
  assignments  TrainingAssignment[]

  @@unique([orgId, title])
}

/// One person's training on one course. ASSIGNED → (SUBMITTED, awaiting a
/// trainer's sign-off) → COMPLETED, or CANCELLED. One open assignment per
/// person and course (partial unique index in the migration).
model TrainingAssignment {
  id              String    @id @default(cuid())
  orgId           String
  courseId        String
  userId          String
  status          String    @default("ASSIGNED")
  dueOn           DateTime? @db.Date
  assignedById    String?
  assignedByName  String
  assignedAt      DateTime  @default(now())
  learnerNote     String    @default("")
  submittedAt     DateTime?
  completedAt     DateTime?
  signedOffById   String?
  signedOffByName String?
  signoffNote     String    @default("")
  qualificationId String?
  cancelledAt     DateTime?
  cancelReason    String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user         User           @relation("TrainingLearner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orgId, status])
  @@index([courseId])
}

/// Rota (phase 8): one shift at a site on a day. `userId` null is an open
/// shift. A required qualification only warns when the person does not hold
/// it on that day; the rota never blocks (owner decision, September 2026).
model RotaShift {
  id             String    @id @default(cuid())
  orgId          String
  siteId         String
  date           DateTime  @db.Date
  startMinutes   Int
  endMinutes     Int
  role           String
  requiredTypeId String?
  userId         String?
  note           String    @default("")
  createdById    String?
  createdByName  String
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Who is rostered, from the imported roster: set for everyone on it,
  /// login or not. `userId` is also set when that person has an account.
  rotaPersonId   String?
  /// "shift" (times), "holiday" (FHOP, full holiday paid) or "leave" (another
  /// roster code, kept in `note`). Only shifts count as work.
  kind           String    @default("shift")
  /// The roster's department code, e.g. "520"; its site and label are in RotaDepartment.
  departmentCode String?
  /// The roster upload that created it; null for a shift added by hand.
  importId       String?

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  site         Club               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  requiredType QualificationType? @relation(fields: [requiredTypeId], references: [id], onDelete: SetNull)
  user         User?              @relation("RotaShiftAssignee", fields: [userId], references: [id], onDelete: SetNull)
  rotaPerson   RotaPerson?        @relation(fields: [rotaPersonId], references: [id], onDelete: SetNull)
  import       RotaImport?        @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([siteId, date])
  @@index([userId, date])
  @@index([rotaPersonId, date])
  @@index([importId])
}

/// Someone on the imported roster (the payroll export's EmpNo and name),
/// login or not. Linked to their Turnfin account when one clearly matches, so
/// they see their shifts in Turnfin Me.
model RotaPerson {
  id         String   @id @default(cuid())
  orgId      String
  employeeNo String
  name       String
  userId     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User?         @relation("RotaPersonAccount", fields: [userId], references: [id], onDelete: SetNull)
  shifts       RotaShift[]
  absences     RotaAbsence[]

  @@unique([orgId, employeeNo])
}

/// A roster department code (e.g. "520") and where it works: its site and a
/// label for the rota. A code without a site stops an import until a manager
/// says where it belongs.
model RotaDepartment {
  id        String   @id @default(cuid())
  orgId     String
  code      String
  label     String   @default("")
  siteId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  site         Club?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([orgId, code])
}

/// One upload of a week's roster. A later upload of the same week replaces
/// its shifts; what moved is recorded as RotaChange rows.
model RotaImport {
  id             String   @id @default(cuid())
  orgId          String
  weekStart      DateTime @db.Date
  fileName       String
  importedById   String?
  importedByName String
  shifts         Int      @default(0)
  holidays       Int      @default(0)
  people         Int      @default(0)
  added          Int      @default(0)
  removed        Int      @default(0)
  changed        Int      @default(0)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  rotaShifts   RotaShift[]
  changes      RotaChange[]

  @@index([orgId, weekStart])
}

/// What one re-upload changed for one person on one day: "added", "removed"
/// or "changed", with the day's entries before and after as plain text.
model RotaChange {
  id         String   @id @default(cuid())
  orgId      String
  importId   String
  date       DateTime @db.Date
  employeeNo String
  personName String
  kind       String
  before     String   @default("")
  after      String   @default("")
  createdAt  DateTime @default(now())

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  import       RotaImport   @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([orgId, date])
}

/// Someone off work (Rota, docs/rota.md): sickness, a family emergency, a
/// bereavement or another reason, from `firstDay` to `lastDay` (null while
/// they are still off). Their shifts in that time warn "Absent" on the rota;
/// the reason is shown only to rota managers. `withdrawnAt` marks one
/// recorded in error.
model RotaAbsence {
  id             String    @id @default(cuid())
  orgId          String
  /// The person's account, when they have one; `rotaPersonId` covers everyone
  /// on the imported roster, login or not. At least one is set.
  userId         String?
  rotaPersonId   String?
  reason         String
  firstDay       DateTime  @db.Date
  lastDay        DateTime? @db.Date
  note           String    @default("")
  reportedById   String?
  reportedByName String
  withdrawnAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User?        @relation("RotaAbsentPerson", fields: [userId], references: [id], onDelete: Cascade)
  rotaPerson   RotaPerson?  @relation(fields: [rotaPersonId], references: [id], onDelete: Cascade)

  @@index([orgId, firstDay])
  @@index([userId, firstDay])
  @@index([rotaPersonId, firstDay])
}
