// Work modules that live in the main database: Refunds, Training and Rota.
// (Docs and HR keep their own databases.)

// Refunds is a separate staff module. Identity/site IDs and names are snapshots;
// retiring accounts or facilities must not erase a financial handoff's history.
model RefundRequest {
  id String @id
  number Int @unique @default(autoincrement())
  status String @default("DRAFT")
  version Int @default(1)
  creatorId String
  creatorName String
  clubId String
  clubName String
  customerName String @default("")
  contactEmail String @default("")
  contactPhone String @default("")
  memberNumber String @default("")
  service String @default("OTHER")
  description String @default("")
  requestedCents Int?
  paymentDate String @default("")
  paymentReference String @default("")
  reason String @default("")
  handlerId String?
  handlerName String?
  approvedCents Int?
  approvedById String?
  approvedByName String?
  paidOn String?
  paidMethod String?
  paidReference String?
  paidById String?
  paidByName String?
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events RefundEvent[]
  attachments RefundAttachment[]
  notifications RefundNotification[]
  @@index([status, submittedAt])
  @@index([clubId, status])
  @@index([creatorId])
  @@index([handlerId])
  @@index([paymentReference])
}

model RefundEvent {
  id String @id @default(cuid())
  requestId String
  operationId String
  actorId String
  actorName String
  action String
  note String @default("")
  snapshot Json
  createdAt DateTime @default(now())
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  notifications RefundNotification[]
  @@unique([requestId, operationId])
  @@index([requestId, createdAt])
}

model RefundAttachment {
  id String @id
  requestId String
  name String
  mime String
  size Int
  bytes Bytes
  createdById String
  createdAt DateTime @default(now())
  removedAt DateTime?
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@index([requestId])
}

model RefundNotification {
  id String @id @default(cuid())
  requestId String
  eventId String
  recipientId String
  status String @default("PENDING")
  attempts Int @default(0)
  attemptedAt DateTime?
  error String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  event RefundEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@unique([eventId, recipientId])
  @@index([requestId, status])
}

/// Training (phase 6): a course in the organisation's catalogue. Learners read
/// the material and mark it done; a practical course also needs a trainer's
/// sign-off. Completing a course that grants a qualification records it, with
/// the expiry from the qualification type's validity.
model TrainingCourse {
  id              String    @id @default(cuid())
  orgId           String
  title           String
  summary         String    @default("")
  /// Plain-text material: what to read, watch or practise.
  content         String    @default("")
  requiresSignoff Boolean   @default(false)
  grantsTypeId    String?
  archivedAt      DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  grantsType   QualificationType?   @relation(fields: [grantsTypeId], references: [id], onDelete: SetNull)
  assignments  TrainingAssignment[]

  @@unique([orgId, title])
}

/// One person's training on one course. ASSIGNED → (SUBMITTED, awaiting a
/// trainer's sign-off) → COMPLETED, or CANCELLED. One open assignment per
/// person and course (partial unique index in the migration).
model TrainingAssignment {
  id              String    @id @default(cuid())
  orgId           String
  courseId        String
  userId          String
  status          String    @default("ASSIGNED")
  dueOn           DateTime? @db.Date
  assignedById    String?
  assignedByName  String
  assignedAt      DateTime  @default(now())
  learnerNote     String    @default("")
  submittedAt     DateTime?
  completedAt     DateTime?
  signedOffById   String?
  signedOffByName String?
  signoffNote     String    @default("")
  qualificationId String?
  cancelledAt     DateTime?
  cancelReason    String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user         User           @relation("TrainingLearner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orgId, status])
  @@index([courseId])
}

/// Rota (phase 8): one shift at a site on a day. `userId` null is an open
/// shift. A required qualification only warns when the person does not hold
/// it on that day; the rota never blocks (owner decision, September 2026).
model RotaShift {
  id             String    @id @default(cuid())
  orgId          String
  siteId         String
  date           DateTime  @db.Date
  startMinutes   Int
  endMinutes     Int
  role           String
  requiredTypeId String?
  userId         String?
  note           String    @default("")
  createdById    String?
  createdByName  String
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  site         Club               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  requiredType QualificationType? @relation(fields: [requiredTypeId], references: [id], onDelete: SetNull)
  user         User?              @relation("RotaShiftAssignee", fields: [userId], references: [id], onDelete: SetNull)

  @@index([siteId, date])
  @@index([userId, date])
}

/// Someone off work (Rota, docs/rota.md): sickness, a family emergency, a
/// bereavement or another reason, from `firstDay` to `lastDay` (null while
/// they are still off). Their shifts in that time warn "Absent" on the rota;
/// the reason is shown only to rota managers. `withdrawnAt` marks one
/// recorded in error.
model RotaAbsence {
  id             String    @id @default(cuid())
  orgId          String
  userId         String
  reason         String
  firstDay       DateTime  @db.Date
  lastDay        DateTime? @db.Date
  note           String    @default("")
  reportedById   String?
  reportedByName String
  withdrawnAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User         @relation("RotaAbsentPerson", fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, firstDay])
  @@index([userId, firstDay])
}
