// Turnfin Courses (apps/courses, docs/courses.md): the standalone app at courses.turnfin.app.
// Its new tables. It also owns the tables in activities.prisma, activities.short-courses.prisma
// and academy.prisma, shared with Turnfin's own modules until the switch (D34).
// People sign in with their Turnfin account (users); these tables keep only its id.
// No relations to the platform's tables: ids only.

/// Wrong passwords at Courses' sign-in, per person, so sign-in can pause after too many.
/// Courses never writes the users table.
model CoursesSignIn {
  /// The person: users.id.
  userId        String    @id
  /// Wrong passwords since the last success.
  failedSignIns Int       @default(0)
  lockedUntil   DateTime?
  lastSignInAt  DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("courses_sign_ins")
}

/// One signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model CoursesSession {
  id         String   @id @default(cuid())
  /// The person: users.id.
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("courses_sessions")
}

/// Every change made in Turnfin Courses: who, what, which record, when.
/// Written in the same transaction as the change.
model CoursesLog {
  id        String   @id @default(cuid())
  orgId     String
  /// The person (users.id). Null for a script.
  userId    String?
  /// Kept beside the id so the log reads the same after a person's name changes.
  actorName String
  /// `<thing>.<past-tense-verb>`, e.g. "person.signed_in".
  action    String
  /// The kind of record and its id, where the change was to one record.
  record    String?
  recordId  String?
  siteId    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([record, recordId])
  @@index([userId, createdAt])
  @@map("courses_log")
}
