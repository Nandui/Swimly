// Incidents (owner request, 11 October 2026; docs/incidents.md): accidents,
// incidents and near misses at a site, reported by a duty manager or supervisor
// (owner decision, 12 October 2026), triaged by the centre
// or operations manager and, when serious, signed off by the operations manager.
// Tables carry the module prefix (CLAUDE.md section 4).

/// One report. The reporter's words are locked when it is submitted; later
/// corrections are addenda in `IncidentEvent`.
model IncidentReport {
  id                String    @id @default(cuid())
  /// Shown as INC-00042.
  number            Int       @unique @default(autoincrement())
  orgId             String?
  siteId            String
  /// One of the site's areas (Admin, Areas) or free text when it has none.
  area              String    @default("")
  /// accident | incident | near_miss
  kind              String
  /// See `incidentCategories` in src/modules/incidents/shared/types.ts.
  category          String
  /// The site's own date and time, as the reporter saw the clock.
  occurredOn        String
  occurredAt        String
  /// What happened, in the reporter's words.
  description       String
  /// What was done straight away: made safe, pool cleared, area closed.
  immediateAction   String    @default("")
  /// reported | investigating | closed
  status            String    @default("reported")
  /// Set at submission when the report says ambulance, hospital, a rescue or a
  /// dangerous occurrence: the managers are alerted at once.
  serious           Boolean   @default(false)
  reporterId        String
  reporterName      String
  /// Who first told the reporter about it (name and role), when they didn't see
  /// it themselves. Empty when they did.
  raisedBy          String    @default("")

  severityActual    Int?
  severityPotential Int?
  /// Whether it must be reported to the Health and Safety Authority, decided at triage.
  hsaReportable     Boolean?
  /// Someone died (Irish law, S.I. 370/2016 reg. 225): the HSA or the Gardaí are
  /// told at once by the quickest means, and the written report is due within
  /// 5 working days rather than 10.
  hsaFatal          Boolean   @default(false)
  /// The date the HSA report is due by (10 working days after the event, 5 for a death).
  hsaDueOn          String?
  /// The IR1 or IR3 reference, or the date it was sent.
  hsaReference      String    @default("")
  /// Who told a child's parent or guardian, and when, in their words.
  parentInformed    String    @default("")
  /// The triage questions for this kind of report (owner request, 19 October
  /// 2026), such as the Garda incident number for a theft: key to a yes/no or
  /// a short answer. See src/modules/incidents/shared/triage-guides.ts.
  triageAnswers     Json      @default("{}")
  triageNote        String    @default("")
  triagedById       String?
  triagedByName     String?
  triagedAt         DateTime?
  closeNote         String    @default("")
  closedById        String?
  closedByName      String?
  closedAt          DateTime?
  /// The investigation (phase 2, 12 October 2026): up to five "why?" answers,
  /// each asking why of the one before, and the root cause they lead to.
  whys              String[]  @default([])
  rootCause         String    @default("")

  version           Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  people        IncidentPerson[]
  witnesses     IncidentWitness[]
  events        IncidentEvent[]
  reads         IncidentAccessEvent[]
  notifications IncidentNotification[]
  statements    IncidentStatement[]
  actions       IncidentAction[]
  files         IncidentFile[]

  @@index([siteId, status])
  @@index([reporterId])
  @@map("incidents_reports")
}

/// Someone involved: hurt, or at the centre of it. Injury and treatment are
/// shown only to people who investigate, and every read is logged.
model IncidentPerson {
  id         String   @id @default(cuid())
  reportId   String
  /// public | swimmer | staff | contractor
  type       String
  /// The staff member, when it was one of the team (phase 3): their injury then
  /// shows on their HR personal file. Never set for anyone else.
  userId     String?
  /// child | adult
  ageGroup   String
  name       String   @default("")
  contact    String   @default("")
  injured    Boolean  @default(false)
  bodyPart   String   @default("")
  injury     String   @default("")
  firstAid   String   @default("")
  firstAidBy String   @default("")
  ambulance  Boolean  @default(false)
  hospital   Boolean  @default(false)
  createdAt  DateTime @default(now())

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([userId])
  @@map("incidents_people")
}

/// Someone who saw it, and how to reach them for a statement.
model IncidentWitness {
  id        String   @id @default(cuid())
  reportId  String
  name      String
  contact   String   @default("")
  createdAt DateTime @default(now())

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@map("incidents_witnesses")
}

/// The report's history: submitted, triaged, closed, and every addendum.
model IncidentEvent {
  id        String   @id @default(cuid())
  reportId  String
  actorId   String
  actorName String
  /// One of `incidentActions` in shared/types.ts: submit, triage, close, addendum,
  /// statement, investigation, action_*, file_*, reopen, export.
  action    String
  note      String   @default("")
  createdAt DateTime @default(now())

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("incidents_events")
}

/// Every time someone other than the reporter opened a report's injury details.
model IncidentAccessEvent {
  id        String   @id @default(cuid())
  reportId  String
  actorId   String
  actorName String
  createdAt DateTime @default(now())

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("incidents_access_events")
}

/// An alert email about a serious report: queued in the same transaction as
/// the report, sent straight after it commits.
model IncidentNotification {
  id          String    @id @default(cuid())
  reportId    String
  /// A staff member's id, or "unassigned" when nobody could be alerted.
  recipientId String
  /// PENDING | SENT | FAILED
  status      String    @default("PENDING")
  error       String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@map("incidents_notifications")
}

/// A statement taken during an investigation: someone's own account, written
/// down by the investigator. Locked once saved; a correction is a new statement.
model IncidentStatement {
  id             String   @id @default(cuid())
  reportId       String
  /// Who gave it, and as what ("Aoife, lifeguard on the slide").
  givenBy        String
  givenAs        String   @default("")
  /// The day it was given (YYYY-MM-DD).
  takenOn        String
  text           String
  recordedById   String
  recordedByName String
  createdAt      DateTime @default(now())

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@map("incidents_statements")
}

/// A corrective action: what will change so it does not happen again, who
/// owns it and by when. A report closes only when none is left open.
model IncidentAction {
  id                String    @id @default(cuid())
  reportId          String
  title             String
  ownerId           String
  ownerName         String
  /// YYYY-MM-DD
  dueOn             String
  /// open | done | cancelled
  status            String    @default("open")
  /// What was done, or why it was dropped.
  note              String    @default("")
  doneById          String?
  doneByName        String?
  doneAt            DateTime?
  createdById       String
  createdByName     String
  createdAt         DateTime  @default(now())
  /// The emails to the owner: when it was given to them, the day before it is
  /// due and the day after it was due. An error stays for the investigators.
  assignedEmailAt   DateTime?
  dueEmailAt        DateTime?
  overdueEmailAt    DateTime?
  emailError        String?

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([status, dueOn])
  @@index([ownerId, status])
  @@map("incidents_actions")
}

/// A photo or document added to a report. Kept in the database like refund
/// receipts; removing one hides it but keeps the record.
model IncidentFile {
  id          String    @id @default(cuid())
  reportId    String
  name        String
  mime        String
  size        Int
  bytes       Bytes
  addedById   String
  addedByName String
  createdAt   DateTime  @default(now())
  removedAt   DateTime?
  removedById String?

  report IncidentReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@map("incidents_files")
}
