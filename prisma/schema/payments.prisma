// Payments (owner, 2 November 2026): the direct debits that failed each month, from the bank's
// failure sheet until reception has recovered each one. Legend stays the billing system: Turnfin
// never takes money or changes a mandate, it only keeps who was contacted and how each ended.
// Sites, people and swimmers are other owners' and read only through their functions, so the
// tables keep plain ids and names. Failures are closed, never deleted.

/// One monthly failure sheet as it was uploaded: which month, by whom, and what it added.
model PaymentImport {
  id             String   @id
  orgId          String
  /// The month the direct debits were collected, "2026-09".
  month          String
  fileName       String
  /// Rows on the sheet with a reference, and how many of them were new (the rest were already in).
  rows           Int
  added          Int
  totalCents     Int
  uploadedById   String
  uploadedByName String
  createdAt      DateTime @default(now())

  @@index([orgId, month])
  @@map("payment_imports")
}

/// One failed direct debit, and how it was recovered or why it ended.
model PaymentFailure {
  id            String                @id @default(cuid())
  orgId         String
  siteId        String
  importId      String
  /// The collection month, "2026-09".
  month         String
  /// The bank's reference, "A/LWC10244". One reference can fail twice in a month for different
  /// amounts, so a debit is its reference, amount and `copy` within the month: uploading the same
  /// sheet again adds nothing.
  reference     String
  /// 1 for the first row with this reference and amount on the month's sheet, 2 for a second.
  copy          Int                   @default(1)
  /// Legend's member number as on the sheet, "LWC10244"; "" when the sheet had none.
  memberNumber  String                @default("")
  /// The swimmer holding that member number when the sheet was uploaded; null for gym members
  /// and anyone not on the swimmer records.
  memberId      String?
  /// The account holder's name as the bank gave it.
  name          String
  amountCents   Int
  /// The bank's return code and its words, "AM04" "Insufficient Funds".
  returnCode    String                @default("")
  returnReason  String                @default("")
  /// to_contact | contacted | paid | new_mandate | cancelled (`PAYMENT_STATUS_META`)
  status        String                @default("to_contact")
  attempts      Int                   @default(0)
  lastContactAt DateTime?
  /// What the last close said.
  outcome       String                @default("")
  version       Int                   @default(1)
  closedAt      DateTime?
  closedById    String?
  closedByName  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  events        PaymentFailureEvent[]

  @@unique([orgId, month, reference, amountCents, copy])
  @@index([orgId, siteId, status])
  @@index([memberId, status])
  @@index([orgId, memberNumber])
  @@map("payment_failures")
}

/// A failure's history: each contact and each change, with the note given. `operationId` makes a
/// repeated press of the same button land once.
model PaymentFailureEvent {
  id          String         @id @default(cuid())
  orgId       String
  failureId   String
  operationId String
  actorId     String
  actorName   String
  action      String
  /// For a contact: phone | text | email | desk, and no_answer | message | spoke.
  method      String         @default("")
  result      String         @default("")
  note        String         @default("")
  createdAt   DateTime       @default(now())
  failure     PaymentFailure @relation(fields: [failureId], references: [id], onDelete: Restrict)

  @@unique([failureId, operationId])
  @@index([failureId, createdAt])
  @@map("payment_failure_events")
}
