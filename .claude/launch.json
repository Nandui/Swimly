{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "swimly-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "sandbox",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/sandbox.mts"
      ],
      "port": 3100,
      "url": "http://localhost:3100"
    }
  ]
}
