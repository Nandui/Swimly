{
  "openapi": "3.1.0",
  "info": {
    "title": "LeisureWorld Aquatics Parent API",
    "version": "1.0.0",
    "description": "Parent backend hosted by Swimly. No direct database or staff API access. Monday progress writes are released Tuesday 00:00 Europe/Dublin. All responses use Cache-Control: no-store. Bearer sessions last seven days. Class transfers and parent booking cancellation are outside v1."
  },
  "servers": [
    {
      "url": "/api/parent/v1",
      "description": "Relative to the Swimly API host"
    }
  ],
  "security": [
    {
      "parentBearer": []
    }
  ],
  "paths": {
    "/auth/request-code": {
      "post": {
        "operationId": "requestParentCode",
        "summary": "Email a ten-minute verification code",
        "tags": [
          "Parents"
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challengeId": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "challengeId",
                    "expiresAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCode"
              }
            }
          }
        }
      }
    },
    "/auth/verify-code": {
      "post": {
        "operationId": "verifyParentCode",
        "summary": "Sign in or create a verified parent account",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "tokenType": {
                      "const": "Bearer"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "parent": {
                      "$ref": "#/components/schemas/Parent"
                    }
                  },
                  "required": [
                    "accessToken",
                    "tokenType",
                    "expiresAt",
                    "parent"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCode"
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutParent",
        "summary": "Revoke the current session",
        "tags": [
          "Parents"
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getParent",
        "summary": "Read the signed-in parent",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Parent"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateParent",
        "summary": "Set parent contact details before booking",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Parent"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParentUpdate"
              }
            }
          }
        }
      }
    },
    "/children": {
      "get": {
        "operationId": "listChildren",
        "summary": "List only children explicitly linked to this parent",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Child"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/children/{childId}": {
      "get": {
        "operationId": "getChild",
        "summary": "Read a linked child; unrelated and missing IDs both return 404",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Child"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/children/{childId}/progress": {
      "get": {
        "operationId": "getChildProgress",
        "summary": "Read only progress released at the next Dublin midnight",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Progress"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/sites": {
      "get": {
        "operationId": "listSites",
        "summary": "List active assessment sites",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NameAndId"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/assessment-sessions": {
      "get": {
        "operationId": "listAssessmentSessions",
        "summary": "Browse staff-published sessions; at most 90 days per search",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AssessmentSession"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ]
      }
    },
    "/assessment-bookings": {
      "get": {
        "operationId": "listAssessmentBookings",
        "summary": "List bookings for linked children, including bookings made by staff",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Booking"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "childId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ]
      },
      "post": {
        "operationId": "bookAssessment",
        "summary": "Reserve a place for a linked child or register and book a new child atomically",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Idempotent retry; booking reflects current status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookAssessment"
              }
            }
          }
        }
      }
    },
    "/assessment-sessions/{sessionId}": {
      "get": {
        "operationId": "getAssessmentSession",
        "summary": "Read one open published assessment, including full sessions",
        "tags": [
          "Assessments"
        ],
        "security": [],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentSession"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "parentBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque 256-bit token; not a JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Parent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "phone"
        ],
        "additionalProperties": false
      },
      "Child": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "dateOfBirth": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "dateOfBirth",
          "status"
        ],
        "additionalProperties": false
      },
      "NameAndId": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "AssessmentSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "site": {
            "$ref": "#/components/schemas/NameAndId"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "startMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1439
          },
          "startsAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "durationMinutes": {
            "type": "integer"
          },
          "timezone": {
            "const": "Europe/Dublin"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "programme": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NameAndId"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "description"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "spacesAvailable": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Null means uncapped."
          },
          "bookingClosesAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "bookable": {
            "type": "boolean"
          },
          "cancelled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "site",
          "date",
          "startMinutes",
          "startsAt",
          "durationMinutes",
          "timezone",
          "location",
          "programme",
          "type",
          "spacesAvailable",
          "bookingClosesAt",
          "bookable",
          "cancelled"
        ],
        "additionalProperties": false
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "childId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "BOOKED",
              "ATTENDED",
              "NO_SHOW",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "session": {
            "$ref": "#/components/schemas/AssessmentSession"
          }
        },
        "required": [
          "id",
          "childId",
          "status",
          "createdAt",
          "session"
        ],
        "additionalProperties": false
      },
      "BookingReceipt": {
        "type": "object",
        "properties": {
          "booking": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "childId": {
                "type": "string"
              },
              "sessionId": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "BOOKED",
                  "ATTENDED",
                  "NO_SHOW",
                  "CANCELLED"
                ]
              }
            },
            "required": [
              "id",
              "childId",
              "sessionId",
              "status"
            ],
            "additionalProperties": false
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "booking",
          "replayed"
        ],
        "additionalProperties": false
      },
      "Competency": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_ASSESSED",
              "WORKING_ON",
              "ACHIEVED"
            ]
          },
          "assessedOn": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "status",
          "assessedOn"
        ],
        "additionalProperties": false
      },
      "Completion": {
        "type": "object",
        "properties": {
          "completedOn": {
            "type": "string",
            "format": "date"
          },
          "achieved": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "completedOn",
          "achieved",
          "total"
        ],
        "additionalProperties": false
      },
      "ProgressLevel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "current": {
            "type": "boolean"
          },
          "achieved": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "completion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Completion"
              },
              {
                "type": "null"
              }
            ]
          },
          "competencies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Competency"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "current",
          "achieved",
          "total",
          "completion",
          "competencies"
        ],
        "additionalProperties": false
      },
      "Progress": {
        "type": "object",
        "properties": {
          "childId": {
            "type": "string"
          },
          "timezone": {
            "const": "Europe/Dublin"
          },
          "programmes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "levels": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProgressLevel"
                  }
                }
              },
              "required": [
                "id",
                "name",
                "levels"
              ],
              "additionalProperties": false
            }
          },
          "assessmentOutcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bookingId": {
                  "type": "string"
                },
                "level": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/NameAndId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "assessedOn": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "bookingId",
                "level",
                "assessedOn"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "childId",
          "timezone",
          "programmes",
          "assessmentOutcomes"
        ],
        "additionalProperties": false
      },
      "RequestCode": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "VerifyCode": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "challengeId",
          "code"
        ],
        "additionalProperties": false
      },
      "ParentUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "NewChild": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "dateOfBirth"
        ],
        "additionalProperties": false
      },
      "BookAssessment": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "childId": {
                "type": "string"
              }
            },
            "required": [
              "sessionId",
              "childId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "newChild": {
                "$ref": "#/components/schemas/NewChild"
              }
            },
            "required": [
              "sessionId",
              "newChild"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
