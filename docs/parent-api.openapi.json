{
  "openapi": "3.1.0",
  "info": {
    "title": "LeisureWorld Aquatics Parent API",
    "version": "1.2.0",
    "description": "Parent backend hosted by Swimly. No direct database or staff API access. Monday progress writes are released Tuesday 00:00 Europe/Dublin. All responses use Cache-Control: no-store. Bearer sessions last seven days. Class transfers and parent booking cancellation are outside v1."
  },
  "servers": [
    {
      "url": "/api/parent/v1",
      "description": "Relative to the Swimly API host"
    }
  ],
  "security": [
    {
      "parentBearer": []
    }
  ],
  "paths": {
    "/auth/request-code": {
      "post": {
        "operationId": "requestParentCode",
        "summary": "Email a ten-minute verification code",
        "tags": [
          "Parents"
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challengeId": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "challengeId",
                    "expiresAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestCode"
              }
            }
          }
        }
      }
    },
    "/auth/verify-code": {
      "post": {
        "operationId": "verifyParentCode",
        "summary": "Sign in or create a verified parent account",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "tokenType": {
                      "const": "Bearer"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "parent": {
                      "$ref": "#/components/schemas/Parent"
                    }
                  },
                  "required": [
                    "accessToken",
                    "tokenType",
                    "expiresAt",
                    "parent"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCode"
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutParent",
        "summary": "Revoke the current session",
        "tags": [
          "Parents"
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getParent",
        "summary": "Read the signed-in parent",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Parent"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateParent",
        "summary": "Set parent contact details before booking",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Parent"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParentUpdate"
              }
            }
          }
        }
      }
    },
    "/children": {
      "get": {
        "operationId": "listChildren",
        "summary": "List only children explicitly linked to this parent",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Child"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/children/{childId}": {
      "get": {
        "operationId": "getChild",
        "summary": "Read a linked child; unrelated and missing IDs both return 404",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Child"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/children/{childId}/progress": {
      "get": {
        "operationId": "getChildProgress",
        "summary": "Read only progress released at the next Dublin midnight",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Progress"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/sites": {
      "get": {
        "operationId": "listSites",
        "summary": "List active assessment sites",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NameAndId"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/assessment-sessions": {
      "get": {
        "operationId": "listAssessmentSessions",
        "summary": "Browse staff-published sessions; at most 90 days per search",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AssessmentSession"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ]
      }
    },
    "/assessment-bookings": {
      "get": {
        "operationId": "listAssessmentBookings",
        "summary": "List bookings for linked children, including bookings made by staff",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Booking"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "childId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ]
      },
      "post": {
        "operationId": "bookAssessment",
        "summary": "Reserve a place for a linked child or register and book a new child atomically",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Idempotent retry; booking reflects current status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookAssessment"
              }
            }
          }
        }
      }
    },
    "/assessment-sessions/{sessionId}": {
      "get": {
        "operationId": "getAssessmentSession",
        "summary": "Read one open published assessment, including full sessions",
        "tags": [
          "Assessments"
        ],
        "security": [],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentSession"
                }
              }
            }
          }
        }
      }
    },
    "/access-requests": {
      "get": {
        "operationId": "listParentAccessRequests",
        "summary": "List only this parent’s linking requests and staff replies",
        "tags": [
          "Parents"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Twenty requests per page, newest first. Internal notes, matched swimmer IDs and reviewer identities are excluded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "page",
                    "total"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AccessRequest"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Authentication, input or service error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "requestChildAccess",
        "summary": "Ask staff to link an existing child; creates no swimmer or access grant",
        "tags": [
          "Parents"
        ],
        "description": "Requires a verified active parent and completed parent name. Maximum ten pending requests; thirty creation attempts per hour. Same-key retries retain the original body; duplicate pending child details return the existing request. Staff approve or decline inside Swimly. No request email is sent.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessRequestInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing request returned for an idempotent retry or duplicate pending child.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Request created and audited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Errors include PROFILE_REQUIRED, IDEMPOTENCY_CONFLICT, REQUEST_LIMIT and RATE_LIMITED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/children/{childId}/lessons": {
      "get": {
        "operationId": "getChildLessons",
        "summary": "Read a linked child’s next weekly lesson and 12-week attendance report",
        "tags": [
          "Parents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChildLessons"
                }
              }
            }
          },
          "default": {
            "description": "Error; see code. Responses are never cacheable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Current guardian approval is required, across all sites. Finds the earliest enrolled, non-cancelled occurrence ending after now within 90 days, including date-specific teaching cover. End dates are exclusive. Attendance uses only this child’s saved records for completed lessons over the last 84 dates inclusive. Late counts as attended; cancellations and missing records do not affect the percentage. No staff notes or other children are exposed. Lesson details use the current timetable; skill publication is unchanged."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "parentBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque 256-bit token; not a JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Parent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "phone"
        ],
        "additionalProperties": false
      },
      "Child": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "dateOfBirth": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "dateOfBirth",
          "status"
        ],
        "additionalProperties": false
      },
      "NameAndId": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "AssessmentSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "site": {
            "$ref": "#/components/schemas/NameAndId"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "startMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1439
          },
          "startsAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "durationMinutes": {
            "type": "integer"
          },
          "timezone": {
            "const": "Europe/Dublin"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "programme": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NameAndId"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "description"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "spacesAvailable": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Null means uncapped."
          },
          "bookingClosesAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "bookable": {
            "type": "boolean"
          },
          "cancelled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "site",
          "date",
          "startMinutes",
          "startsAt",
          "durationMinutes",
          "timezone",
          "location",
          "programme",
          "type",
          "spacesAvailable",
          "bookingClosesAt",
          "bookable",
          "cancelled"
        ],
        "additionalProperties": false
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "childId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "BOOKED",
              "ATTENDED",
