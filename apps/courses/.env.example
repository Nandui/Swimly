# Copy to .env and fill in. .env is ignored; this file is not.

# Turnfin's main database (the same one Turnfin uses). Courses never migrates it:
# migrations live in ../../prisma/migrations and are applied by Turnfin's build.
DATABASE_URL="postgresql://user:password@localhost:5432/swimly?schema=public"

# Optional: the most connections the pool opens. Leave unset; set to 1 against the sandbox.
# DATABASE_POOL_MAX="1"
